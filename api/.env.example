# =============================================
# CamHost.space — Backend Environment Config
# Place this file as .env inside api/ or root
# Keep this file private and never commit to Git!
# =============================================

# Telegram Bot Token & Chat ID
# Get Bot Token from @BotFather
# Get Chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot API Mode (false = Telegram Cloud 50MB limit, true = Local Server 2GB limit)
TELEGRAM_LOCAL_MODE=false
TELEGRAM_LOCAL_URL=http://127.0.0.1:8081

# JWT Secret for user session tokens (min 32 characters)
JWT_SECRET=

# Default Admin Credentials (created on first boot)
ADMIN_EMAIL=admin@camhost.space
ADMIN_PASSWORD=AdminSecureCamHost2026!

# Allowed Frontend Origins (comma-separated, strictly enforced)
ALLOWED_ORIGINS=https://camhost.space,http://localhost:3000,http://localhost:5173

# App URL & Frontend
APP_URL=https://api.camhost.space
FRONTEND_URL=https://camhost.space

# Hostinger SMTP Email Settings (System alert from noreply, user replies go to support)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=noreply@camhost.space
SMTP_PASS=YourEmailPasswordHere
SMTP_FROM=noreply@camhost.space
SMTP_FROM_NAME="CamHost.space"
SMTP_REPLY_TO=support@camhost.space

